# WordPress / WooCommerce
WP_URL=https://your-store.example.com
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me
WP_USERNAME=ai-store-manager
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# MCP runtime - keep these values in EasyPanel
MCP_HOST=0.0.0.0
MCP_PORT=8090
MCP_PATH=/mcp
HTTP_TIMEOUT_SECONDS=30
VERIFY_TLS=true
LOG_LEVEL=INFO
AUDIT_LOG=/data/audit.jsonl

# SAFETY: start read-only
ALLOW_WRITES=false
ALLOW_PRICE_WRITES=false
ALLOW_STOCK_WRITES=false
ALLOW_PUBLISH=false
ALLOW_EXTERNAL_IMAGE_URLS=false
MAX_BULK_WRITE=20

# Translation behavior
TRANSLATION_COPY_PRICE=true
TRANSLATION_COPY_IMAGES=true
TRANSLATION_COPY_PHYSICAL_FIELDS=true
TRANSLATION_COPY_STOCK=false

# Only allow known/tested SEO meta keys
ALLOWED_META_KEYS=rank_math_title,rank_math_description,_yoast_wpseo_title,_yoast_wpseo_metadesc
