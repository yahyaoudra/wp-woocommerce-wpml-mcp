# Single-user/private starter deployment.
# IMPORTANT: replace BOTH placeholders before using this.
# ChatGPT MCP URL becomes: https://mcp.example.com/<RANDOM_SECRET>/mcp
# The random secret should be at least 32 random bytes (64 hex chars).

mcp.example.com {
    @mcp path /<RANDOM_SECRET>/mcp*
    handle @mcp {
        uri strip_prefix /<RANDOM_SECRET>
        reverse_proxy 127.0.0.1:8090
    }

    # Do not expose /mcp directly.
    respond 404
}
